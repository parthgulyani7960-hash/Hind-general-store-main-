rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Global Default Deny ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == 'parthgulyani7960@gmail.com' ||
        request.auth.token.email == 'admin@hindstore.com' ||
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        exists(/databases/$(database)/documents/admin_whitelist/$(request.auth.token.email))
      ); 
    }
    
    function isCustomer() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'customer'
      );
    }
    
    function isDelivery() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'delivery' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'runner')
      );
    }

    // --- User Profiles ---
    match /users/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // --- Admin Whitelist ---
    match /admin_whitelist/{email} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- Configurations & Settings ---
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /user_addresses/{addressId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (incoming().user_id == request.auth.uid || incoming().userId == request.auth.uid);
      allow update: if isSignedIn() && (resource.data.user_id == request.auth.uid || resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin() || (isSignedIn() && (resource.data.user_id == request.auth.uid || resource.data.userId == request.auth.uid));
    }

    // --- Catalog & Marketing ---
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{categoryId} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }
    match /product_variants/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /promotions/{promoId} { 
      allow read: if true; 
      allow write: if isAdmin(); 
    }
    match /promotional_rules/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /promotion_products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /bulk_discounts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /suppliers/{id} {
      allow read, write: if isAdmin();
    }
    match /coupons/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Transactional & Order Processing ---
    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.user_id == request.auth.uid || 
        isAdmin() ||
        isDelivery()
      );
      allow create: if isSignedIn() && (
        incoming().userId == request.auth.uid || 
        incoming().user_id == request.auth.uid
      );
      allow update: if isAdmin() || isDelivery();
      allow delete: if isAdmin();
    }
    match /order_items/{itemId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.user_id == request.auth.uid || 
        isAdmin() ||
        isDelivery()
      );
      allow write: if isAdmin();
    }
    match /order_status_history/{historyId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.user_id == request.auth.uid || 
        isAdmin() ||
        isDelivery()
      );
      allow write: if isAdmin() || isDelivery();
    }
    match /cart_items/{itemId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().user_id == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
    }
    match /carts/{cartId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().user_id == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
    }
    match /returns/{returnId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.user_id == request.auth.uid || 
        isAdmin()
      );
      allow create: if isSignedIn() && (
        incoming().userId == request.auth.uid || 
        incoming().user_id == request.auth.uid
      );
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /purchase_records/{recordId} {
      allow read, write: if isAdmin();
    }
    match /expenses/{id} {
      allow read, write: if isAdmin();
    }

    // --- Wallets, Payments & Khata ---
    match /wallet_transactions/{txId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
    match /wallet_history/{historyId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
    match /wallet_requests/{requestId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().user_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /payment_qrs/{qrId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // --- Support & Real-time Ticketing ---
    match /tickets/{ticketId} { 
      allow read: if isSignedIn() && (
        resource.data.user_id == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isSignedIn() && (
        incoming().user_id == request.auth.uid || 
        incoming().userId == request.auth.uid
      );
      allow update: if isAdmin() || (
        isSignedIn() && (
          resource.data.user_id == request.auth.uid || 
          resource.data.userId == request.auth.uid
        )
      );
      allow delete: if isAdmin();
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/tickets/$(ticketId)).data.user_id == request.auth.uid ||
          get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId == request.auth.uid ||
          isAdmin()
        );
        allow create: if isSignedIn() && (
          get(/databases/$(database)/documents/tickets/$(ticketId)).data.user_id == request.auth.uid ||
          get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId == request.auth.uid ||
          isAdmin()
        );
        allow update, delete: if isAdmin();
      }

      match /timeline_events/{eventId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/tickets/$(ticketId)).data.user_id == request.auth.uid ||
          get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId == request.auth.uid ||
          isAdmin()
        );
        allow create, update, delete: if isAdmin();
      }
    }

    // Legacy Support Ticketing Matcher
    match /support_tickets/{ticketId} { 
      allow read: if isSignedIn() && (
        resource.data.user_id == request.auth.uid || 
        resource.data.userId == request.auth.uid || 
        isAdmin()
      ); 
      allow create: if isSignedIn();
      allow update: if isAdmin() || (
        isSignedIn() && (
          resource.data.user_id == request.auth.uid || 
          resource.data.userId == request.auth.uid
        )
      );
      allow delete: if isAdmin();
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.user_id == request.auth.uid ||
          get(/databases/$(database)/documents/support_tickets/$(ticketId)).data.userId == request.auth.uid ||
          isAdmin()
        );
        allow create: if isSignedIn();
      }
    }

    // --- Notifications, Alerts & Announcements ---
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /user_alerts/{alertId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }
    match /newsletter/{id} {
      allow read, write: if isAdmin();
    }
    match /newsletter_campaigns/{id} {
      allow read, write: if isAdmin();
    }
    match /reviews/{reviewId} { 
      allow read: if true; 
      allow create: if isSignedIn();
      allow update, delete: if isAdmin(); 
    }

    // --- Logistics & Delivery ---
    match /delivery_areas/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /runners/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /logistics_events/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isDelivery();
    }

    // --- System Integrity, Security & Logs ---
    match /bug_reports/{reportId} {
      allow create: if true;
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /error_logs/{logId} {
      allow create: if true;
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /system_logs/{id} {
      allow create: if true;
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /incident_logs/{id} {
      allow create: if true;
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /audit_incidents/{id} {
      allow create: if true;
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /emails_log/{id} {
      allow read, write: if isAdmin();
    }
    match /email_queue/{id} {
      allow read, write: if isAdmin();
    }
    match /security_logs/{logId} {
      allow create: if true;
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /audit_logs/{logId} { 
      allow create: if true;
      allow read: if isAdmin(); 
      allow write: if isAdmin();
    }
    match /deletion_requests/{requestId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().user_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /login_attempts/{ip} {
      allow read, write: if true;
    }
    match /stats/{id} {
      allow read, write: if isAdmin();
    }
    match /data_exports/{id} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().user_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /_health_/{id} {
      allow read, write: if true;
    }
  }
}
